{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "echora",
  "version": "0.2.1",
  "identifier": "com.sidneyroberto9.echora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "echora",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "externalBin": [
      "binaries/echora-mpv",
      "binaries/echora-yt-dlp",
      "binaries/echora-deno"
    ],
    "resources": {
      "binaries/lib/*": "lib/"
    },
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2", "libpulse0"],
        "postInstallScript": "../scripts/deb-postinst.sh",
        "postRemoveScript": "../scripts/deb-postrm.sh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5MUVENzA0MTI4N0EwOEYKUldTUG9JY1NCTmNlK1YyS2s5cTdSeklNRWtsMXdKVnBQRlBoN2ppTFFFSzhhS2VTN3B6c2hmWWoK",
      "endpoints": [
        "https://github.com/SidneyRoberto9/echora/releases/latest/download/latest.json"
      ]
    }
  }
}
