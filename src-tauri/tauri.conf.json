{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "echora",
  "version": "0.1.0",
  "identifier": "com.sidneyroberto9.echora",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "echora",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_REPLACE_WITH_REAL_PUBKEY_AT_PACKAGING_TIME",
      "endpoints": [
        "https://github.com/SidneyRoberto9/echora/releases/latest/download/latest.json"
      ]
    }
  }
}
